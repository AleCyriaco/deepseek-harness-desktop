{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.1.5",
  "identifier": "com.deepseek.dshdesktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend/node_modules/": "backend/node_modules/"
    },
    "category": "DeveloperTool",
    "shortDescription": "Native desktop shell for the DeepSeek Harness",
    "longDescription": "Runs the DeepSeek Harness web GUI in a native window, backed by the stock `dsh web` server started as a child process.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
